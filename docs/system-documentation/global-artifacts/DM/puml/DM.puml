@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

class RailwayInfrastructure {

}

class RailLine {
    id
    name
}

class LineSegment {
    length
    gaugeWidth
    maxWeight
    speedLimit
}

class Electrification {
    id
}

class SingleTrackSegment extends LineSegment {
}

class DoubleTrackSegment extends LineSegment {
}

class Siding {
  name
  location
}

abstract class Endpoint {
    name
    location
}

class Owner {
    name
}

class Operator {
    name
}

class Station extends Endpoint{

}
class Terminal extends Endpoint{

}

class IntermodalTerminal extends Terminal {
}

class FreightYard {
    name
    location
}

class Warehouse {
}

class RefrigeratedArea {
}

class GrainSilo {
}

abstract class RollingStock {
   id
   make
   model
}

class Gauge {
    code
    width
}

class Locomotive extends RollingStock {
    entryYear
    power
    acceleration
    weight
    bogieCount
}

class DieselLocomotive extends Locomotive {
    fuelCapacity
}

class ElectricLocomotive extends Locomotive {
}

class Wagon extends RollingStock {
    payload
    volCapacity
    tare
}

class Train {
    id
}

class Boxcar extends Wagon {
 }
class Flatcar extends Wagon {
    maxStackLevel
}
class TankCar extends Wagon {
 }
class HopperCar extends Wagon {
}
class RefrigeratedCar extends Wagon {
}

class ChemicalTankCar extends TankCar {
 }
class MineralOilCar   extends TankCar {
 }
class PressureGasCar  extends TankCar {
 }

 class Container {
    length
    isHighCube
}

class Dimension {
    length
    width
    height
}

class Freight {
    id
}

class Route {
id
complexity
}

class Path {
id
}

class PathStep {
    order
}

class CirculationLine {
    id
}

class ParkingLine {
    id
}

class UnloadingDock {
    id
}

class Aisle {
    id
    aisleNo
}

class Bay {
    id
    capacity
    bayNo
}

class Box {
    id
    quantity
    expiryDate
    receivedAt
}

class Item {
    sku
    name
    category
    unit
    volume
    unitWeight
    isPerishable
}

class Order {
    id
    dueDate
    priority
}

class OrderLine {
    lineNo
    quantity
}

class Return {
    id
    quantity
    reason
    timestamp
    expiryDate
}

class Quarantine {
    id
    startDate
}

class InspectionLog {
    timestamp
    returnId
    sku
    action
    qty
    qtyRestocked
    qtyDiscarded
}

class TerminalOperator {
    name
}

class WarehousePlanner {
    name
}


class Trolley {
    id
    weightCapacity
}

class PickPlan {
    status
}



RailwayInfrastructure "1" -> "*" RailLine : includes
RailLine "1" --> "*" LineSegment : composed of
SingleTrackSegment "0..*" ---> "0..*" Siding : has crossing areas
RailLine "1" --> "1" Endpoint : from
RailLine "1" --> "1" Endpoint : to
LineSegment "1" --> "1" Endpoint : from
LineSegment "1" --> "1" Endpoint : to
RailLine "1" --> "1" Owner : has
RailLine "1" --> "*" Operator : used by of
Terminal "1" ---> "*" Warehouse : may include
Station "1" ---> "*" Warehouse : may include
Terminal "1" ---> "*" RefrigeratedArea : may include
Station "1" ---> "*" RefrigeratedArea : may include
Terminal "1" ---> "*" GrainSilo : may include
Station "1" ---> "*" GrainSilo : may include
Operator "1" --- "0..*" RollingStock : owns >
Train "1" -- "1..*" RollingStock : is composed of >
Train "*" ---> "*" RailLine : run on >
Flatcar "1" -- "*" Container : carries >
Locomotive "1" -- "0..1" Dimension : has >
Wagon "1" -- "0..1" Dimension : has >
Bay "1" -- "0..1" Dimension : has >
Freight "1"--- "1..*" Wagon : consists of
Freight "1" --> "1" Station : from >
Freight "1" --> "1" Station : to   >
Train "1"--- "1..*" Freight : transports >
Path "1" -- "1..*" PathStep : consists of >
PathStep "1" --> "1" LineSegment : via >
PathStep "1" --> "1" Station : passes >
Route "1" -- "1..*" Freight
Terminal "1" -- "1..*" CirculationLine : has >
Terminal "1" -- "1..*" ParkingLine    : has >
Terminal "1" -- "1..*" UnloadingDock  : has >
Warehouse "1" -- "1..*" Aisle : organized in >
Aisle     "1" -- "1..*" Bay : has >
Bay "1" -- "0..*" Box : stores >
Wagon "1" -- "0..*" Box : carries >
UnloadingDock "1" --> "1..*" Warehouse : connects to >
Box "1" -- "1" Item : contains >
Order "1" -- "1..*" OrderLine : has >
OrderLine "1" --> "1" Item : refers to >
Return "1" --> "1" Item : returned product >
LineSegment "0..*" --> "0..1" Electrification : electrified by >
ElectricLocomotive     "1"    --> "1..*" Electrification : compatible with >
RailwayInfrastructure "1" *-- "*" Station : includes >
RailwayInfrastructure "1" *-- "*" Terminal : includes >
RailwayInfrastructure "1" *-- "*" FreightYard : includes >
FreightYard "1" --- "*" Train : handles >
TerminalOperator "1"---"1" UnloadingDock : operates at
TerminalOperator "1"--- "1..*" Bay : relocates
TerminalOperator "1" *--- "1..*" Order : dispatches
WarehousePlanner "1"---"1..*" Box   : allocates >
RollingStock "1" -- "1..*" Gauge : supports >
LineSegment "0..*" --> "1" Gauge : has >
PickPlan "1" --> "1" Trolley     : is loaded onto >
PickPlan "1" --> "1" OrderLine   : fulfills >
PickPlan "1" --> "1" Item        : picks >
OrderLine "1" -- "*" PickPlan    : is split into >
Trolley   "1" -- "*" PickPlan    : aggregates picks from >
Quarantine "1" -- "1..*" Return : contains >
Return "1" -- "1..*" InspectionLog : recorded in >
TerminalOperator "1" -- "0..*" InspectionLog : performs >
Return "1" --> "1" Item : refers to >





@enduml