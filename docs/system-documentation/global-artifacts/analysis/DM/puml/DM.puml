@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods


class RailLine {
    id
    name
}

class LineSegment {
    length
    maxWeight
    speedLimit
    isEletrified
}

class SingleTrackSegment extends LineSegment {
}

class MultipleTrackSegment extends LineSegment {
    trackNum
}

class Siding {
  name
}


class Station{
    country
    timeZone
    timeZoneGroup
    isCity
    isMainStation
    isAirport
}

class Warehouse {
}

class RefrigeratedArea {
}

class GrainSilo {
}


class Gauge {
    code
    width
}

class Locomotive {
    id
    entryYear
    power
    acceleration
    weight
    bogieCount
}

class DieselLocomotive extends Locomotive  {
    fuelCapacity
}

class ElectricLocomotive extends Locomotive  {
    voltage
    frequency
}

class Wagon  {
    id
    make
    model
    payload
    volCapacity
    tare
}

class WagonType {
    name
}

class Train {
    id
    maxLength
    startPlanDate
}


class Dimension {
    length
    width
    height
}

class Freight {
    id
}

class LocomotiveModel {
    make
    modelName
}


class Route {
id
complexity
}

class Path {
id
}

class PathStep {
    order
    mustStop
}

class CirculationLine {
    id
}

class ParkingLine {
    id
}

class UnloadingDock {
    id
}

class Aisle {
    id
    aisleNo
}

class Bay {
    id
    capacity
    bayNo
}

class Box {
    id
    quantity
    expiryDate
    receivedAt
}

class Item {
    sku
    name
    category
    unit
    volume
    unitWeight
    isPerishable
}

class Order {
    id
    dueDate
    priority
}

class OrderLine {
    lineNo
    quantity
}

class Return {
    id
    quantity
    reason
    timestamp
    expiryDate
}

class Quarantine {
    id
    startDate
}

class InspectionLog {
    timestamp
    returnId
    sku
    action
    qty
    qtyRestocked
    qtyDiscarded
}

class Trolley {
    id
    weightCapacity
}

class PickPlan {
    status
    quantity
}

class Location {
    latitude
    longitude
}

class StationType {
}

class TrainMovement {
    arrivalTime
    departureTime
}


RailLine *-- "*" LineSegment : composed of
SingleTrackSegment "1" -- "0..*" Siding : has crossing areas
RailLine "1" --> "1" Station : from
RailLine "1" --> "1" Station : to
Station "1" *-- "0..*" RefrigeratedArea : may include
Station "1" *-- "0..*" GrainSilo : may include
Train "1" -- "1..*" Locomotive : is composed of >
Train "1" -- "0..*" Wagon      : is composed of >
Train "*" ---> "*" RailLine : run on >
Locomotive "1" -- "0..1" Dimension : has >
Wagon      "1" -- "0..1" Dimension : has >
Bay        "1" -- "0..1" Dimension : has >
Freight "1"--- "1..*" Wagon : consists of
Freight "1" --> "1" Station : from >
Freight "1" --> "1" Station : to   >
Train "1"--> "1" Route : executes >
Path "1" *-- "1..*" PathStep : consists of>
PathStep "1" --> "1" LineSegment : via >
PathStep "1" --> "1" Station : passes >
Route "1" -- "1..*" Freight : groups >
Station "1" *-- "0..*" CirculationLine : may include >
Station "1" *-- "0..*" ParkingLine    : may include >
Warehouse "1" -- "1..*" Aisle : organized in >
Aisle     "1" -- "1..*" Bay : has >
Bay "1" -- "0..*" Box : stores >
Wagon "1" -- "0..*" Box : carries >
Box "1" -- "1" Item : contains >
Order "1" *-- "1..*" OrderLine : has >
OrderLine "1" --> "1" Item : refers to >
LineSegment "1" --> "1" Gauge : has >
PickPlan "1" --> "1" Trolley     : is loaded onto >
PickPlan "1" --> "1" OrderLine   : fulfills >
PickPlan "1" --> "1" Item        : picks >
OrderLine "1" -- "*" PickPlan    : is split into >
Trolley   "1" -- "*" PickPlan    : aggregates picks from >
Quarantine "1" -- "1..*" Return : contains >
Return "1" *-- "1..*" InspectionLog : recorded in >
Return "1" --> "1" Item : refers to >
Station "1" --> "1" Location : has >
Siding "1" --> "1" Location : has >
Wagon "1" --> "1" WagonType : has >
Station "1" --> "1" StationType : has >
Station "1" *-- "0..*" Warehouse : has >
Warehouse "1" *--> "0..*" UnloadingDock  : has >
Locomotive "1" -- "1..*" Gauge : supports >
Wagon      "1" -- "1..*" Gauge : supports >
Locomotive "1" --> "1" LocomotiveModel
Train "1" -- "0..*" TrainMovement : has records >
TrainMovement "1" --> "1" Station : at >










@enduml